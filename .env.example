# Kopiraj ovaj fajl u .env i popuni vrijednosti. .env NE ide u git.

# Adzuna API — https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Apify API token — https://console.apify.com/account/integrations
APIFY_API_KEY=

# PostgreSQL. Ako lozinka sadrzi @ : / # ili ?, URL-enkoduj je (@ -> %40)
DATABASE_URL=postgresql+psycopg://postgres:LOZINKA@localhost:5432/jobmarket
